# Raw data caches we don't want to commit (keep results/ checked in for README)
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json
!data/raw/.gitkeep

# results/ is checked in: charts and JSON exports are referenced from the
# README and docs, and a fresh clone needs them visible without re-running
# the pipeline.
